[Unit]
Description=Rotate the piece shown on the Frame TV

[Timer]
# The TV's own slideshow only offers 3, 15, 60 or 1440 minutes and does not
# persist the setting, so the rotation is driven from here instead and the
# interval is whatever we want.
OnCalendar=*:0/5
Persistent=false

[Install]
WantedBy=timers.target
