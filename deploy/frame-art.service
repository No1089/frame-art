[Unit]
Description=Frame TV art pipeline
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/frame-art
ExecStart=/opt/frame-art/run_pipeline.sh
# Fetch walks three museum APIs at one request per second, so an hour is not
# generous. The pipeline is idempotent: already downloaded, prepared and
# uploaded items are skipped via catalogue.json and uploaded.json.
TimeoutStartSec=7200

[Install]
WantedBy=multi-user.target
